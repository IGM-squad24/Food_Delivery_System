@model FoodDeliverySystem.Models.Customer
@{ ViewData["Title"] = "Customer Details"; }

<h1><i class="bi bi-person"></i> @Model.Name</h1>
<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Customer Information</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4">Address</dt><dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">Registered</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white"><h5 class="mb-0">Order History (@Model.Orders.Count)</h5></div>
            <div class="card-body p-0">
                @if (Model.Orders.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Order #</th><th>Restaurant</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                            {
                                <tr>
                                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                                    <td>@order.Restaurant.Name</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>$@order.TotalAmount.ToString("F2")</td>
                                    <td><span class="badge bg-@(order.Status == FoodDeliverySystem.Models.OrderStatus.Delivered ? "success" : order.Status == FoodDeliverySystem.Models.OrderStatus.Cancelled ? "danger" : "warning")">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3">No orders yet.</p> }
            </div>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
