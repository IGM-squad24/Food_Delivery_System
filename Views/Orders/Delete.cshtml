@model FoodDeliverySystem.Models.Order
@{ ViewData["Title"] = "Delete Order"; }

<h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Order</h1>
<h4>Are you sure you want to delete this order?</h4>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Order #</dt><dd class="col-sm-8">@Model.Id</dd>
            <dt class="col-sm-4">Customer</dt><dd class="col-sm-8">@Model.Customer.Name</dd>
            <dt class="col-sm-4">Restaurant</dt><dd class="col-sm-8">@Model.Restaurant.Name</dd>
            <dt class="col-sm-4">Total</dt><dd class="col-sm-8">$@Model.TotalAmount.ToString("F2")</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge bg-warning">@Model.Status</span></dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
