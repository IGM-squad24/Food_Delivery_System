@model FoodDeliverySystem.Models.Order
@{ ViewData["Title"] = "Edit Order"; }

<h1><i class="bi bi-pencil"></i> Edit Order #@Model.Id</h1>
<div class="row"><div class="col-md-8">
    <div class="card shadow-sm"><div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OrderDate" />
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="@(Html.GetEnumSelectList<FoodDeliverySystem.Models.OrderStatus>())"></select>
            </div>
            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" class="form-select" asp-items="@(ViewData["CustomerId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)"></select>
            </div>
            <div class="mb-3">
                <label asp-for="RestaurantId" class="form-label"></label>
                <select asp-for="RestaurantId" class="form-select" asp-items="@(ViewData["RestaurantId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)"></select>
            </div>
            <div class="mb-3">
                <label asp-for="DeliveryDriverId" class="form-label"></label>
                <select asp-for="DeliveryDriverId" class="form-select" asp-items="@(ViewData["DeliveryDriverId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                    <option value="">-- Unassigned --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="DeliveryAddress" class="form-label"></label>
                <input asp-for="DeliveryAddress" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="TotalAmount" class="form-label"></label>
                    <div class="input-group"><span class="input-group-text">$</span>
                        <input asp-for="TotalAmount" class="form-control" />
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EstimatedDeliveryTime" class="form-label"></label>
                    <input asp-for="EstimatedDeliveryTime" class="form-control" type="datetime-local" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ActualDeliveryTime" class="form-label"></label>
                    <input asp-for="ActualDeliveryTime" class="form-control" type="datetime-local" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div></div>
</div></div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
