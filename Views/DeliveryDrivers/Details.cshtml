@model FoodDeliverySystem.Models.DeliveryDriver
@{ ViewData["Title"] = "Driver Details"; }

<h1><i class="bi bi-bicycle"></i> @Model.Name</h1>
<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Driver Information</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4">Vehicle</dt><dd class="col-sm-8">@Model.VehicleType</dd>
                    <dt class="col-sm-4">License #</dt><dd class="col-sm-8">@Model.LicenseNumber</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsAvailable) { <span class="badge bg-success">Available</span> }
                        else { <span class="badge bg-secondary">Unavailable</span> }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white"><h5 class="mb-0">Delivery History (@Model.Orders.Count)</h5></div>
            <div class="card-body p-0">
                @if (Model.Orders.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Order #</th><th>Customer</th><th>Restaurant</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                            {
                                <tr>
                                    <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                                    <td>@order.Customer.Name</td>
                                    <td>@order.Restaurant.Name</td>
                                    <td><span class="badge bg-@(order.Status == FoodDeliverySystem.Models.OrderStatus.Delivered ? "success" : "warning")">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3">No deliveries yet.</p> }
            </div>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
